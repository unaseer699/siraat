DATABASE_URL=postgres://siraat:siraat_local_dev@localhost:5432/siraat
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
SIRAAT_API_KEY=change-me-before-deploying
# S3-compatible object storage — points at local MinIO in development.
# In production, replace these four values with DO Spaces credentials.
# No code change needed: both speak the same S3 protocol (Phase 10 migration path).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=siraat-evidence
S3_REGION=us-east-1
# WhatsApp Integration Phase 1 — official Meta WhatsApp Business Cloud API.
# WHATSAPP_VERIFY_TOKEN: arbitrary string you choose, entered in the Meta App
# Dashboard's webhook config; validated on the GET verification handshake.
# WHATSAPP_APP_SECRET: from the Meta App Dashboard — used to verify the
# X-Hub-Signature-256 header on every inbound webhook POST.
# WHATSAPP_ACCESS_TOKEN: the Cloud API access token — unused until Phase 3
# (outbound replies), stored now so it's already plumbed through env config.
WHATSAPP_VERIFY_TOKEN=change-me-before-deploying
WHATSAPP_APP_SECRET=change-me
WHATSAPP_ACCESS_TOKEN=change-me
# WhatsApp Integration Phase 2 — AI PARSING. Anthropic API key used by
# WhatsappAiClient to turn a RECEIVED message's free text into a structured
# draft expense (WhatsappDraftExpenseEntity). If unset, parsing degrades
# gracefully to a low-confidence draft with null fields instead of failing
# (see WhatsappAiClient.extractExpense) — useful for local dev without a key.
# ANTHROPIC_MODEL defaults to claude-haiku-4-5-20251001 if unset.
ANTHROPIC_API_KEY=change-me
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
