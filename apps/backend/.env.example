DATABASE_URL=postgres://siraat:siraat_local_dev@localhost:5432/siraat
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
SIRAAT_API_KEY=change-me-before-deploying
# S3-compatible object storage — points at local MinIO in development.
# In production, replace these four values with DO Spaces credentials.
# No code change needed: both speak the same S3 protocol (Phase 10 migration path).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=siraat-evidence
S3_REGION=us-east-1
